{
  "name": "tcc_app_rn",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start",
    "android": "cross-env APP_VARIANT=development expo start --android",
    "normal": "cross-env APP_VARIANT=development expo start --clear --android",
    "dev": "cross-env APP_VARIANT=development npx expo start",
    "build": "npx eas build --platform android --local",
    "buildeas": "npx eas build --platform android --profile development",
    "sudobuild": "cross-env APP_VARIANT=development sudo -E cmd /k 'npm run buildeas && pause'",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration --testTimeout=60000 --runInBand",
    "update": "eas update --branch preview -p android",
    "pnpm": "cross-env APP_VARIANT=development pnpm exec expo start",
    "emulator:list": "emulator -list-avds",
    "emulator:start": "emulator Pixel7Pro -no-audio -no-window &"
  },
  "dependencies": {
    "@react-native-community/slider": "5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@shopify/flash-list": "2.0.2",
    "@types/react": "~19.1.10",
    "@types/rn-material-ui-textfield": "^1.0.7",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-orm": "^0.44.7",
    "eas-cli": "^16.11.0",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-svg": "15.9.0",
    "react-native-paper": "^5.12.3",
    "react-native-paper-dates": "^0.22.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "rn-material-ui-textfield": "^1.0.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.7",
    "@types/jest": "^29.5.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.4"
  },
  "private": true
}
